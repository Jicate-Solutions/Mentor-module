# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# For production (Vercel), set these as Environment Variables in the dashboard

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application URL - IMPORTANT for OAuth redirect URI
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Name
NEXT_PUBLIC_APP_NAME="JKKN Mentor"

# =============================================================================
# MyJKKN AUTH SERVER CONFIGURATION (OAuth 2.0)
# =============================================================================

# MyJKKN Auth Server URL
NEXT_PUBLIC_AUTH_SERVER_URL=https://auth.jkkn.ai

# Your Application ID from MyJKKN Auth Server
# Get this from: https://auth.jkkn.ai/admin/applications
NEXT_PUBLIC_APP_ID=your_app_id_here

# OAuth Redirect URI (OPTIONAL - will be auto-constructed from NEXT_PUBLIC_APP_URL if not set)
# Only set this if you need to override the automatic construction
# Development: http://localhost:3000/callback
# Production: https://your-domain.vercel.app/callback
# IMPORTANT: This MUST match exactly what's registered in MyJKKN Auth Server
NEXT_PUBLIC_REDIRECT_URI=

# Application API Key (Server-side only)
# Get this from: https://auth.jkkn.ai/admin/applications
# WARNING: Keep this secret! Never expose to client.
API_KEY=your_api_key_here

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase Project URL
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Public)
# Get from: Supabase Dashboard → Settings → API → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (Server-side only)
# Get from: Supabase Dashboard → Settings → API → service_role (secret)
# WARNING: Keep this secret! Never expose to client. Only use in API routes.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Access Token (for management operations)
SUPABASE_ACCESS_TOKEN=your_access_token_here

# =============================================================================
# MyJKKN API CONFIGURATION (Data Fetching)
# =============================================================================

# MyJKKN API Key for data operations
# Get from: https://www.jkkn.ai/admin/api-keys
NEXT_PUBLIC_MYJKKN_API_KEY=your_myjkkn_api_key_here

# MyJKKN API Base URL
NEXT_PUBLIC_MYJKKN_BASE_URL=https://www.jkkn.ai/api

# Mock Mode - Set to true for development without API access
NEXT_PUBLIC_MYJKKN_MOCK_MODE=false

# Proxy Mode - Set to true to route API calls through Next.js API routes
NEXT_PUBLIC_MYJKKN_PROXY_MODE=true

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# FOR VERCEL DEPLOYMENT:
# 1. Go to your Vercel project → Settings → Environment Variables
# 2. Add all NEXT_PUBLIC_* variables (these are exposed to the browser)
# 3. Add all secret variables (API_KEY, SUPABASE_SERVICE_ROLE_KEY, etc.)
# 4. IMPORTANT: Set NEXT_PUBLIC_APP_URL to your production URL:
#    - Example: https://mentor-module.vercel.app
#    - Or your custom domain: https://mentor.yourdomain.com
# 5. If using NEXT_PUBLIC_REDIRECT_URI, set it to:
#    - https://your-production-url/callback
# 6. Ensure this redirect URI is registered in MyJKKN Auth Server
# 7. Redeploy your application
#
# OAUTH REDIRECT URI PRIORITY:
# The app will use redirect URIs in this order:
# 1. NEXT_PUBLIC_REDIRECT_URI (if explicitly set)
# 2. NEXT_PUBLIC_APP_URL + /callback (auto-constructed)
# 3. Fallback to localhost:3000/callback (development only)
#
# =============================================================================
